# ── Database ──────────────────────────────────────────
POSTGRES_USER=slide_turbo
POSTGRES_PASSWORD=slide_turbo
POSTGRES_DB=slide_turbo
DB_PORT=5434
DATABASE_URL=postgresql://slide_turbo:slide_turbo@localhost:5433/slide_turbo

# ── Auth / JWT ────────────────────────────────────────
JWT_SECRET=dev-secret-change-me

# ── Google OAuth（Progate のような「Google でログイン」用） ──
# 手順: docs/GOOGLE_LOGIN_SETUP.md を参照（5分で設定可能）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 認可後にユーザーが戻るURL（フロントの /login）。トークン交換時にバックエンドが使用。
GOOGLE_REDIRECT_URI=http://localhost:3000/login
# フロントで Google 認証URL を組み立てる用（バックエンドと同じクライアントIDで可）
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Google Slides URL インポート用。取得手順: docs/GOOGLE_REFRESH_TOKEN.md
GOOGLE_REFRESH_TOKEN=
# リフレッシュトークン取得フローのコールバックURL（通常は変更不要）
# GOOGLE_REFRESH_CALLBACK_URI=http://localhost:3001/api/v1/users/auth/google/refresh-callback

# ── Gemini AI ─────────────────────────────────────────
GEMINI_API_KEY=

# ── Frontend ──────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
