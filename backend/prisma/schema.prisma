// ============================================
// Slide Turbo - Prisma Schema
// ============================================

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User
// ============================================
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  icon      String?
  googleId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slides    Slide[]
  templates Template[]

  @@map("users")
}

// ============================================
// Template
// ============================================
model Template {
  id        String   @id @default(uuid())
  ownerId   String
  title     String
  contents  Json     // テンプレート構造 (スライドレイアウト定義)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User     @relation(fields: [ownerId], references: [id])
  slides    Slide[]

  @@index([ownerId])
  @@map("templates")
}

// ============================================
// Slide (= Project)
// ============================================
model Slide {
  id         String   @id @default(uuid())
  ownerId    String
  templateId String?
  title      String
  images     String[] // プレビュー画像URL群
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner      User      @relation(fields: [ownerId], references: [id])
  template   Template? @relation(fields: [templateId], references: [id])
  versions   SlideVersion[]

  @@index([ownerId])
  @@index([templateId])
  @@map("slides")
}

// ============================================
// SlideVersion
// ============================================
model SlideVersion {
  id         String   @id @default(uuid())
  slideId    String
  versionNum Int
  createdAt  DateTime @default(now())

  slide      Slide    @relation(fields: [slideId], references: [id], onDelete: Cascade)
  pages      Page[]
  outlines   Outline[]

  @@unique([slideId, versionNum])
  @@index([slideId])
  @@map("slide_versions")
}

// ============================================
// Page (= 1スライドページ)
// ============================================
model Page {
  id             String   @id @default(uuid())
  slideVersionId String
  pageNum        Int
  contents       Json     // ページコンテンツ (HTML/構造化データ)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  slideVersion   SlideVersion @relation(fields: [slideVersionId], references: [id], onDelete: Cascade)

  @@unique([slideVersionId, pageNum])
  @@index([slideVersionId])
  @@map("pages")
}

// ============================================
// Outline (= 骨子)
// ============================================
model Outline {
  id             String   @id @default(uuid())
  slideVersionId String
  title          String
  description    String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  slideVersion   SlideVersion @relation(fields: [slideVersionId], references: [id], onDelete: Cascade)

  @@index([slideVersionId])
  @@map("outlines")
}
